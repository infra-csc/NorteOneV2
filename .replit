modules = ["python-3.11", "nodejs-20", "postgresql-16"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"
packages = ["cargo", "glibcLocales", "libiconv", "libxcrypt", "openssl", "pkg-config", "rustc"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Frontend"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Backend API"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Backfill 23/05"

[[workflows.workflow]]
name = "Frontend"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd frontend && npm run dev"
waitForPort = 5000

[[workflows.workflow]]
name = "Backend API"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd backend && python -m uvicorn main:app --host 0.0.0.0 --port 8000 --reload"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "Backfill 23/05"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash backend/scripts/_loop_backfill.sh"

[workflows.workflow.metadata]
outputType = "console"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3001

[[ports]]
localPort = 5999
externalPort = 3000

[[ports]]
localPort = 8000
externalPort = 8000

[deployment]
deploymentTarget = "vm"
run = ["bash", "-c", "cd backend && python -m uvicorn main:app --host 0.0.0.0 --port 5000"]
build = ["bash", "build.sh"]

[userenv]

[userenv.shared]
CORS_ORIGINS = "http://localhost:5000,http://localhost:5173,https://0b827c34-60ec-4b06-8fcd-e09a89148a97-00-xu37byadrs7f.picard.replit.dev"
SSH_HOST_KEY = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAILptjCB6sjk0yPPaeEp/wPje1NklpU4XIKXA63hCmErM"
ENABLE_BACKGROUND_MAGENTO_SYNC = "true"

[userenv.production]
FORCE_RESET_EMAIL = "admin@cscdoesporte.com"
FORCE_RESET_PASSWORD = "Nortemkt@2026"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000
